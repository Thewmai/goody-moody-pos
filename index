<style>

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f8f6f2;--surf:#ffffff;--raised:#f2efea;--hov:#ece9e3;
  --b:#e0ddd7;--bhi:#c8c4bc;
  --amber:#c17a3a;--adim:#9e6230;--abg:#fdf5ed;--atxt:#8a4a1a;
  --red:#c94040;--rbg:#fdf1f1;
  --green:#3d8b60;--gbg:#eef7f1;
  --blue:#3b72c4;--bbg:#edf3fd;
  --t1:#1a1917;--t2:#6b6560;--t3:#a89e96;
  --r:8px;--rl:12px
}
html,body{height:100%;background:var(--bg);color:var(--t1);font-family:'Syne',sans-serif;font-size:14px;overflow:hidden}
.app{display:flex;flex-direction:column;height:100vh}

/* TOPBAR */
.topbar{display:flex;align-items:center;background:var(--surf);border-bottom:1px solid var(--b);padding:0 20px;height:52px;flex-shrink:0}
.logo{font-size:20px;font-weight:800;color:var(--amber);letter-spacing:-.5px;margin-right:32px;text-transform:lowercase}
.logo span{color:var(--t2);font-weight:600}
.tabs{display:flex;gap:2px}
.tab-btn{padding:0 18px;height:52px;background:none;border:none;color:var(--t2);font-family:'Syne',sans-serif;font-size:13px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;transition:all .15s;letter-spacing:.3px}
.tab-btn:hover{color:var(--t1)}
.tab-btn.active{color:var(--amber);border-bottom-color:var(--amber)}
.topbar-right{margin-left:auto;display:flex;align-items:center;gap:16px}
.time{font-family:'DM Mono',monospace;font-size:13px;color:var(--t2)}

/* ALERT BANNER */
.alert-banner{background:var(--abg);border-bottom:1px solid var(--adim);padding:7px 20px;display:flex;align-items:center;gap:10px;font-size:12px;color:var(--atxt);flex-shrink:0}
.alert-banner.hidden{display:none}
.alert-dismiss{background:none;border:none;color:var(--atxt);cursor:pointer;font-size:16px;opacity:.6;margin-left:auto}
.alert-dismiss:hover{opacity:1}

/* VIEWS */
.views-container{flex:1;overflow:hidden;display:flex}
.view{display:none;flex:1;overflow:hidden}
.view.active{display:flex}

/* ===== POS ===== */
.pos-left{flex:1;display:flex;flex-direction:column;overflow:hidden;border-right:1px solid var(--b)}
.pos-right{width:350px;display:flex;flex-direction:column;background:var(--surf)}
.cat-bar{display:flex;gap:8px;padding:14px 16px;background:var(--surf);border-bottom:1px solid var(--b);overflow-x:auto;scrollbar-width:none;flex-shrink:0}
.cat-bar::-webkit-scrollbar{display:none}
.cat-btn{padding:6px 14px;border-radius:20px;border:1px solid var(--b);background:none;color:var(--t2);font-family:'Syne',sans-serif;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all .15s}
.cat-btn:hover{border-color:var(--bhi);color:var(--t1)}
.cat-btn.active{background:var(--amber);border-color:var(--amber);color:#0f1012}
.product-search{padding:12px 16px;border-bottom:1px solid var(--b);background:var(--surf);flex-shrink:0}
.search-input{width:100%;padding:8px 12px;background:var(--bg);border:1px solid var(--b);border-radius:var(--r);color:var(--t1);font-family:'Syne',sans-serif;font-size:13px;outline:none;transition:border-color .15s}
.search-input:focus{border-color:var(--adim)}
.search-input::placeholder{color:var(--t3)}
.product-grid{flex:1;overflow-y:auto;padding:16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;align-content:start}
.product-grid::-webkit-scrollbar{width:4px}
.product-grid::-webkit-scrollbar-thumb{background:var(--b);border-radius:4px}
.product-card{background:var(--surf);border:1px solid var(--b);border-radius:var(--rl);padding:14px 12px;cursor:pointer;transition:all .15s;position:relative;display:flex;flex-direction:column;gap:6px;user-select:none;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.product-card:hover{border-color:var(--adim);background:var(--hov);transform:translateY(-1px);box-shadow:0 4px 12px rgba(0,0,0,.08)}
.product-card:active{transform:translateY(0)}
.product-card.oos{opacity:.45;cursor:not-allowed}
.product-card.oos:hover{transform:none;border-color:var(--b)}
.product-emoji{font-size:28px;line-height:1;margin-bottom:2px}
.product-name{font-size:12px;font-weight:600;color:var(--t1);line-height:1.3}
.product-price{font-family:'DM Mono',monospace;font-size:14px;color:var(--amber);font-weight:500}
.product-stock{font-size:11px;color:var(--t3)}
.product-stock.low{color:var(--red)}
.stock-badge{position:absolute;top:8px;right:8px;font-size:10px;font-weight:600;padding:2px 6px;border-radius:4px}
.badge-out{background:var(--rbg);color:var(--red)}
.badge-low{background:var(--abg);color:var(--atxt)}

/* CART */
.cart-header{padding:14px 16px;border-bottom:1px solid var(--b);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.cart-header-left h2{font-size:13px;font-weight:700;color:var(--t2);letter-spacing:1px;text-transform:uppercase}
.cart-order-num{font-family:'DM Mono',monospace;font-size:11px;color:var(--t3);margin-top:2px}
.note-btn{background:none;border:1px solid var(--b);border-radius:6px;color:var(--t3);cursor:pointer;font-size:11px;padding:4px 10px;font-family:'Syne',sans-serif;font-weight:600;transition:all .15s}
.note-btn:hover{border-color:var(--bhi);color:var(--t2)}
.cart-items{flex:1;overflow-y:auto;padding:8px}
.cart-items::-webkit-scrollbar{width:3px}
.cart-items::-webkit-scrollbar-thumb{background:var(--b)}
.cart-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:10px;color:var(--t3)}
.cart-empty-icon{font-size:36px;opacity:.4}
.cart-item{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;padding:10px;border-radius:var(--r);border:1px solid transparent;transition:background .1s}
.cart-item:hover{background:var(--raised);border-color:var(--b)}
.cart-item-name{font-size:13px;font-weight:600;color:var(--t1)}
.cart-item-price{font-family:'DM Mono',monospace;font-size:11px;color:var(--t2);margin-top:2px}
.qty-ctrl{display:flex;align-items:center;gap:4px}
.qty-btn{width:24px;height:24px;border-radius:6px;border:1px solid var(--b);background:var(--bg);color:var(--t1);cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;transition:all .1s;font-family:monospace}
.qty-btn:hover{border-color:var(--amber);color:var(--amber)}
.qty-num{font-family:'DM Mono',monospace;font-size:13px;min-width:22px;text-align:center}
.line-total{font-family:'DM Mono',monospace;font-size:13px;color:var(--amber);min-width:60px;text-align:right}

/* CART SUMMARY */
.cart-summary{padding:10px 16px;border-top:1px solid var(--b);flex-shrink:0}
.sum-row{display:flex;justify-content:space-between;padding:3px 0;align-items:center}
.sum-lbl{font-size:12px;color:var(--t2)}
.sum-val{font-family:'DM Mono',monospace;font-size:12px;color:var(--t1)}
.sum-total .sum-lbl{font-size:15px;font-weight:700;color:var(--t1)}
.sum-total .sum-val{font-size:20px;font-weight:700;color:var(--amber)}
.disc-row{display:flex;align-items:center;gap:6px;padding:6px 0;border-top:1px solid var(--b);margin-top:4px}
.disc-row label{font-size:11px;color:var(--t3);font-weight:600;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap}
.disc-input{flex:1;padding:5px 8px;background:var(--bg);border:1px solid var(--b);border-radius:6px;color:var(--t1);font-family:'DM Mono',monospace;font-size:12px;outline:none;min-width:0}
.disc-input:focus{border-color:var(--adim)}
.disc-toggle{display:flex;border:1px solid var(--b);border-radius:6px;overflow:hidden}
.disc-type{padding:4px 8px;background:none;border:none;color:var(--t3);cursor:pointer;font-family:'DM Mono',monospace;font-size:11px;transition:all .15s}
.disc-type.active{background:var(--abg);color:var(--atxt)}

/* PAYMENT */
.pay-section{padding:10px 16px 14px;border-top:1px solid var(--b);flex-shrink:0}
.pay-label{font-size:11px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}
.pay-methods{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:10px}
.pay-btn{padding:8px 4px;border-radius:var(--r);border:1px solid var(--b);background:var(--bg);color:var(--t2);cursor:pointer;font-family:'Syne',sans-serif;font-size:11px;font-weight:600;text-align:center;transition:all .15s}
.pay-btn:hover{border-color:var(--bhi);color:var(--t1)}
.pay-btn.active{background:var(--abg);border-color:var(--amber);color:var(--atxt)}
.cash-row{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.cash-row label{font-size:11px;color:var(--t2);white-space:nowrap}
.cash-input{flex:1;padding:7px 10px;background:var(--bg);border:1px solid var(--b);border-radius:var(--r);color:var(--t1);font-family:'DM Mono',monospace;font-size:13px;outline:none}
.cash-input:focus{border-color:var(--green)}
.quick-cash{display:flex;gap:4px;margin-bottom:6px}
.qc-btn{flex:1;padding:5px 2px;background:var(--raised);border:1px solid var(--b);border-radius:6px;color:var(--t2);cursor:pointer;font-family:'DM Mono',monospace;font-size:10px;transition:all .15s;text-align:center}
.qc-btn:hover{border-color:var(--bhi);color:var(--t1)}
.change-box{display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:var(--gbg);border:1px solid rgba(76,175,128,.2);border-radius:var(--r);margin-bottom:8px}
.change-box.neg{background:var(--rbg);border-color:rgba(224,82,82,.2)}
.change-box .lbl{font-size:12px;color:var(--green);font-weight:600}
.change-box.neg .lbl,.change-box.neg .val{color:var(--red)}
.change-box .val{font-family:'DM Mono',monospace;font-size:14px;color:var(--green);font-weight:500}
.clear-btn{width:100%;padding:9px;border-radius:var(--r);background:none;border:1px solid var(--b);color:var(--t2);font-family:'Syne',sans-serif;font-size:13px;cursor:pointer;margin-bottom:8px;transition:all .15s}
.clear-btn:hover{border-color:var(--red);color:var(--red)}
.charge-btn{width:100%;padding:14px;border-radius:var(--r);background:var(--amber);border:none;color:#0f1012;font-family:'Syne',sans-serif;font-size:15px;font-weight:700;cursor:pointer;transition:all .15s}
.charge-btn:hover{background:#f5c56a}
.charge-btn:disabled{background:var(--hov);color:var(--t3);cursor:not-allowed}

/* ===== INVENTORY ===== */
.inv-full{display:flex;flex-direction:column;width:100%;overflow:hidden}
.inv-header{padding:16px 24px;border-bottom:1px solid var(--b);background:var(--surf);display:flex;align-items:center;gap:12px;flex-wrap:wrap;flex-shrink:0}
.inv-header h2{font-size:20px;font-weight:700}
.inv-stats{display:flex;gap:10px;margin-left:auto}
.inv-stat{padding:6px 14px;border-radius:var(--r);border:1px solid var(--b);text-align:center}
.inv-stat-val{font-family:'DM Mono',monospace;font-size:16px;font-weight:500}
.inv-stat-label{font-size:10px;color:var(--t3);letter-spacing:.5px;text-transform:uppercase;margin-top:1px}
.inv-stat.w .inv-stat-val{color:var(--amber)}
.inv-stat.d .inv-stat-val{color:var(--red)}
.inv-stat.ok .inv-stat-val{color:var(--green)}
.add-btn{padding:8px 16px;background:var(--amber);border:none;border-radius:var(--r);color:#0f1012;font-family:'Syne',sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:all .15s;white-space:nowrap}
.add-btn:hover{background:#f5c56a}
.inv-toolbar{padding:10px 24px;border-bottom:1px solid var(--b);display:flex;align-items:center;gap:12px;flex-shrink:0}
.inv-toolbar input{padding:7px 12px;background:var(--bg);border:1px solid var(--b);border-radius:var(--r);color:var(--t1);font-family:'Syne',sans-serif;font-size:13px;outline:none;width:260px}
.inv-toolbar input:focus{border-color:var(--adim)}
.inv-toolbar input::placeholder{color:var(--t3)}
.save-hint{font-size:12px;color:var(--t3);margin-left:auto;font-style:italic}
.inv-table-wrap{flex:1;overflow-y:auto;padding:0 0 20px}
.inv-table{width:100%;border-collapse:collapse}
.inv-table th{text-align:left;padding:10px 16px;font-size:11px;font-weight:700;color:var(--t3);letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid var(--b);background:var(--bg);position:sticky;top:0;z-index:1}
.inv-table td{padding:0;border-bottom:1px solid var(--b);vertical-align:middle}
.inv-table tr:hover td{background:var(--raised)}
.inv-table tr.editing td{background:var(--raised)}

/* INLINE EDIT CELLS */
.cell-wrap{padding:10px 16px;display:flex;align-items:center;gap:8px;min-height:52px}
.item-icon{font-size:20px;width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:var(--hov);border-radius:var(--r);flex-shrink:0;cursor:pointer;transition:background .15s}
.item-icon:hover{background:var(--surf)}
.editable{background:none;border:1px solid transparent;border-radius:6px;color:var(--t1);font-family:'Syne',sans-serif;font-size:14px;font-weight:600;padding:4px 8px;outline:none;transition:all .15s;width:100%}
.editable:hover{border-color:var(--b);background:var(--bg)}
.editable:focus{border-color:var(--amber);background:var(--bg)}
.editable.mono{font-family:'DM Mono',monospace;font-size:14px;font-weight:400}
.editable.cat{font-size:13px;font-weight:400;color:var(--t2)}
.price-wrap{display:flex;align-items:center;gap:2px;padding:10px 16px}
.price-prefix{font-family:'DM Mono',monospace;font-size:13px;color:var(--amber)}
.price-edit{background:none;border:1px solid transparent;border-radius:6px;color:var(--amber);font-family:'DM Mono',monospace;font-size:14px;padding:4px 6px;outline:none;transition:all .15s;width:80px}
.price-edit:hover{border-color:var(--b);background:var(--bg)}
.price-edit:focus{border-color:var(--amber);background:var(--bg)}
.stock-cell{padding:10px 16px}
.stock-editor{display:flex;align-items:center;gap:8px}
.stock-bar-bg{flex:1;height:6px;background:var(--hov);border-radius:3px;min-width:60px;cursor:pointer}
.stock-bar-fill{height:100%;border-radius:3px;transition:width .3s}
.stock-input{background:none;border:1px solid transparent;border-radius:6px;color:var(--t1);font-family:'DM Mono',monospace;font-size:13px;padding:4px 6px;outline:none;width:52px;text-align:center;transition:all .15s}
.stock-input:hover{border-color:var(--b);background:var(--bg)}
.stock-input:focus{border-color:var(--amber);background:var(--bg)}
.status-pill{display:inline-block;padding:3px 10px;border-radius:12px;font-size:11px;font-weight:700;white-space:nowrap}
.s-ok{background:var(--gbg);color:var(--green)}
.s-low{background:var(--abg);color:var(--atxt)}
.s-out{background:var(--rbg);color:var(--red)}
.row-del{padding:5px 9px;border-radius:6px;border:1px solid transparent;background:none;color:var(--t3);cursor:pointer;font-size:13px;transition:all .15s;font-family:'Syne',sans-serif;font-weight:600}
.row-del:hover{border-color:var(--red);color:var(--red);background:var(--rbg)}
.row-remove{padding:5px 10px;border-radius:6px;border:1px solid var(--b);background:none;color:var(--t2);cursor:pointer;font-family:'Syne',sans-serif;font-size:11px;font-weight:600;transition:all .15s;white-space:nowrap}
.row-remove:hover{border-color:var(--adim);color:var(--amber);background:var(--abg)}

/* ADJUSTMENT LOG */
.adj-section{padding:0 24px 28px}
.adj-header{display:flex;align-items:center;justify-content:space-between;padding-top:8px;border-top:1px solid var(--b);margin-bottom:10px}
.adj-title{font-size:11px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:1px}
.adj-clear{background:none;border:none;font-size:11px;color:var(--t3);cursor:pointer;font-family:'Syne',sans-serif;font-weight:600;padding:2px 6px;border-radius:4px;transition:all .15s}
.adj-clear:hover{color:var(--red)}
.adj-table{width:100%;border-collapse:collapse}
.adj-table th{text-align:left;padding:8px 12px;font-size:10px;font-weight:700;color:var(--t3);letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid var(--b)}
.adj-table td{padding:9px 12px;border-bottom:1px solid var(--b);font-size:13px;color:var(--t2)}
.adj-table tr:last-child td{border:none}
.adj-table tr:hover td{background:var(--raised)}
.adj-qty{font-family:'DM Mono',monospace;color:var(--red);font-weight:500}
.adj-pill{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600}
.r-damaged{background:#fef3ee;color:#c05e2a}
.r-expired{background:#fff8e6;color:#9a7000}
.r-stolen{background:var(--rbg);color:var(--red)}
.r-shrinkage{background:#f0f0ff;color:#5050b0}
.r-adjustment{background:var(--raised);color:var(--t2)}
.r-other{background:var(--raised);color:var(--t2)}
.adj-empty{text-align:center;padding:24px;color:var(--t3);font-size:13px;font-style:italic}
.emoji-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:5px;margin-top:6px;max-height:200px;overflow-y:auto;padding-right:4px}
.emoji-opt{aspect-ratio:1;background:var(--bg);border:1px solid var(--b);border-radius:6px;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .1s}
.emoji-opt:hover{border-color:var(--adim);background:var(--hov)}
.emoji-opt.sel{border-color:var(--amber);background:var(--abg)}

/* ===== SALES ===== */
.sales-full{display:flex;flex-direction:column;width:100%;overflow:hidden}
.sales-header{padding:16px 24px;border-bottom:1px solid var(--b);background:var(--surf);display:flex;align-items:center;gap:12px;flex-wrap:wrap;flex-shrink:0}
.sales-header h2{font-size:20px;font-weight:700}
.sales-top-stats{display:flex;gap:10px;margin-left:auto}
.sales-stat{padding:8px 16px;border-radius:var(--r);background:var(--raised);border:1px solid var(--b)}
.sales-stat-val{font-family:'DM Mono',monospace;font-size:18px;font-weight:500;color:var(--amber)}
.sales-stat-label{font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
.sales-body{flex:1;overflow:hidden;display:flex}
.sales-list-col{flex:1;overflow-y:auto;padding:20px 24px}
.sales-right-col{width:290px;flex-shrink:0;overflow-y:auto;border-left:1px solid var(--b);display:flex;flex-direction:column}

/* SUMMARY TABS */
.summary-tabs{display:flex;border-bottom:1px solid var(--b);flex-shrink:0}
.summary-tab{flex:1;padding:12px;background:none;border:none;border-bottom:2px solid transparent;color:var(--t2);font-family:'Syne',sans-serif;font-size:12px;font-weight:700;cursor:pointer;letter-spacing:.5px;text-transform:uppercase;transition:all .15s}
.summary-tab:hover{color:var(--t1)}
.summary-tab.active{color:var(--amber);border-bottom-color:var(--amber)}
.summary-panel{display:none;flex-direction:column;padding:16px;flex:1;overflow-y:auto}
.summary-panel.active{display:flex}

/* SUMMARY CARDS */
.sum-card{background:var(--raised);border:1px solid var(--b);border-radius:var(--rl);padding:14px;margin-bottom:12px}
.sum-card-title{font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px}
.sum-kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:4px}
.kpi{background:var(--bg);border-radius:var(--r);padding:10px;text-align:center}
.kpi-val{font-family:'DM Mono',monospace;font-size:18px;font-weight:500;color:var(--amber)}
.kpi-lbl{font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
.kpi.full{grid-column:1/-1}
.kpi.green .kpi-val{color:var(--green)}
.top-item-row{display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid var(--b)}
.top-item-row:last-child{border:none}
.ti-rank{font-family:'DM Mono',monospace;font-size:11px;color:var(--t3);min-width:16px}
.ti-name{font-size:12px;font-weight:600;flex:1}
.ti-bar-bg{flex:1;height:4px;background:var(--hov);border-radius:2px}
.ti-bar{height:100%;background:var(--amber);border-radius:2px}
.ti-qty{font-family:'DM Mono',monospace;font-size:11px;color:var(--t2);min-width:28px;text-align:right}
.method-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid var(--b)}
.method-row:last-child{border:none}
.method-name{font-size:12px;font-weight:600}
.method-stats{display:flex;gap:12px;align-items:center}
.method-cnt{font-size:11px;color:var(--t2)}
.method-rev{font-family:'DM Mono',monospace;font-size:13px;color:var(--amber)}
.hour-bar-row{display:flex;align-items:flex-end;gap:3px;height:48px;margin-top:4px}
.h-bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px}
.h-bar{width:100%;background:var(--amber);border-radius:2px 2px 0 0;min-height:2px;transition:height .3s}
.h-lbl{font-size:9px;color:var(--t3);font-family:'DM Mono',monospace}

/* SALE CARDS */
.sale-card{background:var(--surf);border:1px solid var(--b);border-radius:var(--rl);margin-bottom:10px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05)}
.sale-head{display:flex;align-items:center;padding:12px 16px;gap:12px;cursor:pointer;transition:background .15s}
.sale-head:hover{background:var(--hov)}
.sale-num{font-family:'DM Mono',monospace;font-size:13px;color:var(--t3)}
.sale-time{font-family:'DM Mono',monospace;font-size:12px;color:var(--t3)}
.sale-mpill{font-size:11px;font-weight:700;padding:3px 8px;border-radius:6px;background:var(--hov);color:var(--t2)}
.sale-amt{font-family:'DM Mono',monospace;font-size:16px;color:var(--amber);margin-left:auto}
.sale-items{padding:10px 16px;display:none;border-top:1px solid var(--b)}
.sale-items.open{display:block}
.sale-line{display:flex;justify-content:space-between;padding:4px 0;font-size:13px;color:var(--t2);border-bottom:1px solid var(--b)}
.sale-line:last-child{border:none}
.sale-line-val{font-family:'DM Mono',monospace;color:var(--t1)}

/* MODALS */
.overlay{display:none;position:fixed;inset:0;background:rgba(100,90,80,.45);z-index:100;align-items:center;justify-content:center}
.overlay.open{display:flex}
.mbox{background:var(--surf);border:1px solid var(--b);border-radius:var(--rl);padding:24px;width:380px;max-height:92vh;overflow-y:auto;box-shadow:0 8px 32px rgba(0,0,0,.12)}
.mtitle{font-size:16px;font-weight:700;margin-bottom:16px}
.mfield{margin-bottom:14px}
.mlabel{font-size:12px;color:var(--t2);margin-bottom:6px;display:block}
.minput{width:100%;padding:10px 12px;background:var(--bg);border:1px solid var(--b);border-radius:var(--r);color:var(--t1);font-family:'DM Mono',monospace;font-size:14px;outline:none;transition:border-color .15s}
.minput:focus{border-color:var(--amber)}
.mselect{width:100%;padding:10px 12px;background:var(--bg);border:1px solid var(--b);border-radius:var(--r);color:var(--t1);font-family:'Syne',sans-serif;font-size:13px;outline:none;cursor:pointer}
.mactions{display:flex;gap:8px;margin-top:8px}
.msave{flex:1;padding:10px;background:var(--amber);border:none;border-radius:var(--r);color:#0f1012;font-family:'Syne',sans-serif;font-size:14px;font-weight:700;cursor:pointer}
.msave:hover{background:#f5c56a}
.mcancel{padding:10px 16px;background:none;border:1px solid var(--b);border-radius:var(--r);color:var(--t2);font-family:'Syne',sans-serif;font-size:14px;cursor:pointer}
.mcancel:hover{border-color:var(--bhi)}

/* RECEIPT */
.receipt-modal .mbox{width:360px;font-family:'DM Mono',monospace}
.r-store-name{text-align:center;font-size:18px;font-weight:500;color:var(--amber);letter-spacing:3px;margin-bottom:4px}
.r-sub-name{text-align:center;font-size:11px;color:var(--t3)}
.r-divider{border:none;border-top:1px dashed var(--bhi);margin:10px 0}
.r-row{display:flex;justify-content:space-between;font-size:13px;padding:3px 0}
.r-lbl{color:var(--t2)}
.r-total-row{display:flex;justify-content:space-between;font-size:16px;font-weight:500;padding:6px 0;color:var(--amber)}
.r-footer{text-align:center;font-size:11px;color:var(--t3);margin-top:10px;line-height:1.6}

/* TOAST */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--raised);border:1px solid var(--adim);color:var(--atxt);padding:10px 20px;border-radius:var(--r);font-size:14px;font-weight:600;transition:transform .25s;z-index:200;pointer-events:none;white-space:nowrap}
.toast.show{transform:translateX(-50%) translateY(0)}
.toast.g{border-color:rgba(76,175,128,.4);color:var(--green)}

::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--b);border-radius:2px}

/* EOD MODAL */
.eod-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.eod-card{background:var(--bg);border:1px solid var(--b);border-radius:var(--r);padding:12px;text-align:center}
.eod-val{font-family:'DM Mono',monospace;font-size:20px;font-weight:500;color:var(--amber)}
.eod-lbl{font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;margin-top:3px}
.eod-card.full{grid-column:1/-1}
.eod-card.green .eod-val{color:var(--green)}
.eod-methods{margin-bottom:14px}
.eod-method-row{display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:var(--bg);border-radius:var(--r);border:1px solid var(--b);margin-bottom:6px}
.eod-method-name{font-size:13px;font-weight:600}
.eod-method-stats{display:flex;gap:14px;align-items:center}
.eod-mcnt{font-size:11px;color:var(--t2)}
.eod-mrev{font-family:'DM Mono',monospace;font-size:14px;color:var(--amber)}
.eod-warning{background:var(--abg);border:1px solid var(--adim);border-radius:var(--r);padding:10px 14px;font-size:12px;color:var(--atxt);margin-bottom:12px}

/* VOID badge */
.void-badge{font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;background:var(--rbg);color:var(--red);margin-left:6px;vertical-align:middle}
.sale-card.voided{opacity:.55}
.sale-card.voided .sale-amt{text-decoration:line-through;color:var(--t3)}

/* SPARKLINE */
.sparkline-wrap{display:flex;align-items:flex-end;gap:4px;height:52px;margin-top:8px}
.spark-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px}
.spark-bar{width:100%;border-radius:3px 3px 0 0;min-height:3px;transition:height .3s}
.spark-day{font-size:9px;color:var(--t3);font-family:'DM Mono',monospace}
.spark-val{font-size:9px;color:var(--t2);font-family:'DM Mono',monospace}

/* PRINT */
@media print{
  body{background:#fff;color:#000;font-family:monospace;font-size:12px}
  .no-print{display:none!important}
  #receipt-modal{display:flex!important;position:static;background:none}
  .mbox{border:none;box-shadow:none;width:320px;margin:0 auto;padding:16px}
  .r-store-name{color:#c17a3a!important;letter-spacing:3px}
  .r-total-row span{color:#000!important}
  .r-lbl,.r-sub-name{color:#555!important}
  .r-divider{border-top:1px dashed #999}
  button{display:none!important}
}

/* LOADING OVERLAY */
#loading-overlay{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;gap:16px;transition:opacity .4s}
#loading-overlay.hidden{opacity:0;pointer-events:none}
.loading-logo{font-size:32px;font-weight:800;color:var(--amber);letter-spacing:-.5px}
.loading-msg{font-size:13px;color:var(--t2)}
.loading-track{width:180px;height:3px;background:var(--b);border-radius:2px;overflow:hidden}
.loading-fill{height:100%;background:var(--amber);width:0%;border-radius:2px;transition:width .4s ease}
/* DB BUSY */
.db-busy{position:fixed;top:14px;right:14px;background:var(--surf);border:1px solid var(--b);border-radius:var(--r);padding:8px 14px;font-size:12px;color:var(--t2);z-index:500;display:none;align-items:center;gap:8px;box-shadow:0 2px 12px rgba(0,0,0,.08)}
.db-busy.show{display:flex}
.db-spin{width:10px;height:10px;border:2px solid var(--b);border-top-color:var(--amber);border-radius:50%;animation:spin .6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
</style>

<!-- LOADING OVERLAY -->
<div id="loading-overlay">
  <div class="loading-logo">goodi moodi</div>
  <div class="loading-msg" id="loading-msg">Connecting to database…</div>
  <div class="loading-track"><div class="loading-fill" id="loading-fill"></div></div>
</div>
<!-- DB BUSY INDICATOR -->
<div class="db-busy" id="db-busy"><div class="db-spin"></div><span>Saving…</span></div>

</head>
<body>
<div class="app">

<!-- TOPBAR -->
<header class="topbar">
  <div class="logo">goodi <span>moodi</span></div>
  <nav class="tabs">
    <button class="tab-btn active" onclick="switchTab('pos',this)">⬡ Point of Sale</button>
    <button class="tab-btn" onclick="switchTab('inventory',this)">⬡ Inventory</button>
    <button class="tab-btn" onclick="switchTab('sales',this)">⬡ Sales History</button>
  </nav>
  <div class="topbar-right">
    <span class="time" id="clock">--:--:--</span>
    <button onclick="openEOD()" style="padding:6px 14px;background:none;border:1px solid var(--b);border-radius:var(--r);color:var(--t2);font-family:'Syne',sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s" onmouseover="this.style.borderColor='var(--amber)';this.style.color='var(--amber)'" onmouseout="this.style.borderColor='var(--b)';this.style.color='var(--t2)'">⊡ End of Day</button>
  </div>
</header>

<!-- ALERT BANNER -->
<div class="alert-banner hidden" id="alert-banner">
  <span>⚠</span>
  <span id="alert-text" style="flex:1"></span>
  <button class="alert-dismiss" onclick="dismissAlert()">✕</button>
</div>

<div class="views-container">

<!-- ===== POS VIEW ===== -->
<div class="view active" id="view-pos">
  <div class="pos-left">
    <div class="cat-bar" id="cat-bar"></div>
    <div class="product-search">
      <input class="search-input" id="pos-search" type="text" placeholder="Search products…" oninput="renderProducts()">
    </div>
    <div class="product-grid" id="product-grid"></div>
  </div>
  <div class="pos-right">
    <div class="cart-header">
      <div class="cart-header-left">
        <h2>Current Order</h2>
        <div class="cart-order-num" id="order-num">#0001</div>
      </div>
      <button class="note-btn" id="note-btn" onclick="openNoteModal()">+ Note</button>
    </div>
    <div id="note-display" style="display:none;padding:6px 16px;background:var(--bbg);border-bottom:1px solid var(--b);font-size:12px;color:var(--blue);font-style:italic"></div>
    <div class="cart-items" id="cart-items">
      <div class="cart-empty"><div class="cart-empty-icon">🧾</div><span>Cart is empty</span></div>
    </div>
    <div id="cart-summary-wrap" style="display:none">
      <div class="cart-summary">
        <div class="sum-row" id="sub-line" style="display:none"><span class="sum-lbl">Subtotal</span><span class="sum-val" id="c-sub">฿0.00</span></div>
        <div class="sum-row" id="disc-line" style="display:none"><span class="sum-lbl" style="color:var(--green)">Discount</span><span class="sum-val" style="color:var(--green)" id="c-disc">-฿0.00</span></div>
        <div class="sum-row sum-total"><span class="sum-lbl">TOTAL</span><span class="sum-val" id="c-total">฿0.00</span></div>
        <div class="disc-row">
          <label>Discount</label>
          <input class="disc-input" id="disc-input" type="number" min="0" placeholder="0" oninput="renderCart()">
          <div class="disc-toggle">
            <button class="disc-type active" id="dt-pct" onclick="setDiscType('pct')">%</button>
            <button class="disc-type" id="dt-flat" onclick="setDiscType('flat')">฿</button>
          </div>
        </div>
      </div>
    </div>
    <div class="pay-section">
      <div class="pay-label">Payment Method</div>
      <div class="pay-methods">
        <button class="pay-btn active" onclick="selectPay(this,'Cash')">💵 Cash</button>
        <button class="pay-btn" onclick="selectPay(this,'Card')">💳 Card</button>
        <button class="pay-btn" onclick="selectPay(this,'QR')">📱 QR</button>
      </div>
      <div id="cash-section">
        <div class="cash-row"><label>Cash Given</label><input class="cash-input" id="cash-input" type="number" min="0" placeholder="0.00" oninput="updateChange()"></div>
        <div class="quick-cash" id="quick-cash"></div>
        <div class="change-box" id="change-box" style="display:none"><span class="lbl">Change</span><span class="val" id="change-val">฿0.00</span></div>
      </div>
      <button class="clear-btn" onclick="clearCart()">Clear Order</button>
      <button class="charge-btn" id="charge-btn" disabled onclick="checkout()">Charge ฿0.00</button>
    </div>
  </div>
</div>

<!-- ===== INVENTORY VIEW ===== -->
<div class="view" id="view-inventory">
  <div class="inv-full">
    <div class="inv-header">
      <h2>Inventory</h2>
      <div class="inv-stats">
        <div class="inv-stat ok"><div class="inv-stat-val" id="i-total">—</div><div class="inv-stat-label">Total SKUs</div></div>
        <div class="inv-stat w"><div class="inv-stat-val" id="i-low">—</div><div class="inv-stat-label">Low Stock</div></div>
        <div class="inv-stat d"><div class="inv-stat-val" id="i-out">—</div><div class="inv-stat-label">Out of Stock</div></div>
      </div>
      <button class="add-btn" onclick="bulkRestock()" style="background:var(--gbg);border:1px solid rgba(76,175,128,.3);color:var(--green)">↑ Restock Low</button>
      <button class="add-btn" onclick="openAddModal()">+ Add Product</button>
    </div>
    <div class="inv-toolbar">
      <input type="text" id="inv-search" placeholder="Filter by name or category…" oninput="renderInventory()">
      <span class="save-hint">Click any cell to edit directly</span>
    </div>
    <div class="inv-table-wrap">
      <table class="inv-table">
        <thead><tr>
          <th style="width:36px"></th>
          <th>Name</th>
          <th style="width:120px">Category</th>
          <th style="width:110px">Price</th>
          <th style="width:220px">Stock</th>
          <th style="width:110px">Status</th>
          <th style="width:120px">Actions</th>
        </tr></thead>
        <tbody id="inv-tbody"></tbody>
      </table>
      <!-- ADJUSTMENT LOG (inside scroll area) -->
      <div class="adj-section" id="adj-section" style="display:none">
        <div class="adj-header">
          <span class="adj-title">Stock Removal Log</span>
          <button class="adj-clear" onclick="clearAdjLog()">Clear log</button>
        </div>
        <table class="adj-table">
          <thead><tr>
            <th>Time</th><th>Product</th><th>Qty Removed</th><th>Reason</th><th>Note</th>
          </tr></thead>
          <tbody id="adj-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ===== SALES VIEW ===== -->
<div class="view" id="view-sales">
  <div class="sales-full">
    <div class="sales-header">
      <h2>Sales History</h2>
      <div class="sales-top-stats">
        <div class="sales-stat"><div class="sales-stat-val" id="s-count">0</div><div class="sales-stat-label">Transactions</div></div>
        <div class="sales-stat"><div class="sales-stat-val" id="s-rev">฿0.00</div><div class="sales-stat-label">All Time Revenue</div></div>
        <div class="sales-stat"><div class="sales-stat-val" id="s-avg">฿0.00</div><div class="sales-stat-label">Avg Order</div></div>
      </div>
      <button onclick="exportCSV()" style="padding:8px 14px;background:none;border:1px solid var(--b);border-radius:var(--r);color:var(--t2);font-family:'Syne',sans-serif;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all .15s" onmouseover="this.style.borderColor='var(--amber)';this.style.color='var(--amber)'" onmouseout="this.style.borderColor='var(--b)';this.style.color='var(--t2)'">⬇ Export Excel</button>
    </div>
    <div class="sales-body">
      <div class="sales-list-col" id="sales-list">
        <div style="text-align:center;color:var(--t3);padding:60px 0;font-size:13px">No sales yet — complete a transaction to see it here.</div>
      </div>
      <div class="sales-right-col">
        <div class="summary-tabs">
          <button class="summary-tab active" onclick="switchSummaryTab('today',this)">Today</button>
          <button class="summary-tab" onclick="switchSummaryTab('week',this)">This Week</button>
          <button class="summary-tab" onclick="switchSummaryTab('analytics',this)">Analytics</button>
        </div>
        <div class="summary-panel active" id="panel-today"></div>
        <div class="summary-panel" id="panel-week"></div>
        <div class="summary-panel" id="panel-analytics"></div>
      </div>
    </div>
  </div>
</div>

</div><!-- /views-container -->
</div><!-- /app -->

<!-- REMOVE STOCK MODAL -->
<div class="overlay" id="remove-modal">
  <div class="mbox" style="width:360px">
    <div class="mtitle">Remove Stock</div>
    <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--raised);border-radius:var(--r);margin-bottom:16px;border:1px solid var(--b)">
      <div id="rm-emoji" style="font-size:24px"></div>
      <div>
        <div id="rm-name" style="font-size:14px;font-weight:700"></div>
        <div id="rm-stock-info" style="font-size:12px;color:var(--t3);margin-top:2px"></div>
      </div>
    </div>
    <div class="mfield">
      <label class="mlabel">Quantity to Remove</label>
      <input class="minput" id="rm-qty" type="number" min="1" placeholder="0" oninput="updateRemovePreview()">
      <div id="rm-preview" style="font-size:12px;color:var(--t3);margin-top:5px;height:16px"></div>
    </div>
    <div class="mfield">
      <label class="mlabel">Reason</label>
      <select class="mselect" id="rm-reason">
        <option value="damaged">Damaged</option>
        <option value="expired">Expired</option>
        <option value="stolen">Stolen / Loss</option>
        <option value="shrinkage">Shrinkage</option>
        <option value="adjustment">Manual Adjustment</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div class="mfield">
      <label class="mlabel">Note <span style="color:var(--t3);font-weight:400">(optional)</span></label>
      <input class="minput" id="rm-note" type="text" placeholder="e.g. Found expired on morning check">
    </div>
    <div class="mactions">
      <button class="mcancel" onclick="closeRemoveModal()">Cancel</button>
      <button class="msave" style="background:var(--red)" onclick="confirmRemoveStock()">Remove Stock</button>
    </div>
  </div>
</div>

<!-- ADD PRODUCT MODAL -->
<div class="overlay" id="add-modal">
  <div class="mbox">
    <div class="mtitle">Add New Product</div>
    <div class="mfield"><label class="mlabel">Product Name</label><input class="minput" id="new-name" type="text" placeholder="e.g. Matcha Latte"></div>
    <div class="mfield"><label class="mlabel">Category</label>
      <select class="mselect" id="new-cat"><option>Coffee</option><option>Tea</option><option>Food</option><option>Drinks</option><option>Other</option></select>
    </div>
    <div class="mfield"><label class="mlabel">Price (฿)</label><input class="minput" id="new-price" type="number" min="1" placeholder="0"></div>
    <div class="mfield"><label class="mlabel">Initial Stock</label><input class="minput" id="new-stock" type="number" min="0" placeholder="0"></div>
    <div class="mfield"><label class="mlabel">Emoji Icon</label><div class="emoji-grid" id="emoji-grid"></div></div>
    <div class="mactions"><button class="mcancel" onclick="closeAddModal()">Cancel</button><button class="msave" onclick="saveNewProduct()">Add Product</button></div>
  </div>
</div>

<!-- NOTE MODAL -->
<div class="overlay" id="note-modal">
  <div class="mbox" style="width:320px">
    <div class="mtitle">Order Note</div>
    <div class="mfield"><label class="mlabel">Note for this order</label>
      <textarea class="minput" id="note-ta" style="height:80px;resize:none;line-height:1.5" placeholder="No ice, extra shot, allergy…"></textarea>
    </div>
    <div class="mactions"><button class="mcancel" onclick="closeNoteModal()">Cancel</button><button class="msave" onclick="saveNote()">Save</button></div>
  </div>
</div>

<!-- EMOJI PICK MODAL (inventory inline) -->
<div class="overlay" id="emoji-modal">
  <div class="mbox" style="width:320px">
    <div class="mtitle">Choose Emoji</div>
    <div class="emoji-grid" id="emoji-modal-grid"></div>
    <div class="mactions" style="margin-top:14px"><button class="mcancel" onclick="closeEmojiModal()">Cancel</button></div>
  </div>
</div>

<!-- RECEIPT MODAL -->
<div class="overlay receipt-modal" id="receipt-modal">
  <div class="mbox">
    <div class="r-store-name">goodi moodi</div>
    <div class="r-sub-name" id="r-date">—</div>
    <hr class="r-divider">
    <div id="r-items"></div>
    <hr class="r-divider">
    <div class="r-row" id="r-disc-row" style="display:none"><span class="r-lbl" style="color:var(--green)">Discount</span><span style="color:var(--green)" id="r-disc">—</span></div>
    <div class="r-row" id="r-sub-row" style="display:none"><span class="r-lbl">Subtotal</span><span id="r-sub">—</span></div>
    <div class="r-total-row"><span>TOTAL</span><span id="r-total">—</span></div>
    <div class="r-row" style="margin-top:8px"><span class="r-lbl">Payment</span><span id="r-method">—</span></div>
    <div class="r-row" id="r-tendered-row"><span class="r-lbl">Cash Given</span><span id="r-tendered">—</span></div>
    <div class="r-row"><span class="r-lbl">Change</span><span id="r-change" style="color:var(--green)">—</span></div>
    <div id="r-note-wrap" style="display:none"><hr class="r-divider"><div id="r-note" style="font-size:12px;color:var(--blue);font-style:italic"></div></div>
