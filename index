<div class="toast" id="toast"></div>

<script>
// ╔══════════════════════════════════════════════════════╗
// ║  CONFIGURATION — replace with your Supabase values  ║
// ╚══════════════════════════════════════════════════════╝
const SUPABASE_URL  = 'https://YOUR_PROJECT_REF.supabase.co'
const SUPABASE_KEY  = 'YOUR_ANON_KEY_HERE'
const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY)

// ===== STATE =====
let products = [], sales = [], adjustments = []
let cart = [], payMethod = 'Cash', discType = 'pct'
let orderNote = '', activeCat = 'All'
let addEmoji = '☕', emojiTargetId = null
let alertDismissed = false, activeSummaryTab = 'today'
let removeTargetId = null

const EMOJIS = ['☕','🥛','🧊','🍵','🫖','🌼','🥐','🧁','🥪','🍰','🍊','🥤','💧','🫧','🍫','🧃','🍹','🍦','🥗','🍜','🥩','🧆','🍕','🍔','🌮','🥞','🍩','🍪','🎂','🫙','🧋','🍷','🥂','🍺','🍸','🌰']

// ===== LOADING UI =====
function setLoading(msg, pct) {
  document.getElementById('loading-msg').textContent = msg
  document.getElementById('loading-fill').style.width = pct + '%'
}
function hideLoading() {
  const el = document.getElementById('loading-overlay')
  el.classList.add('hidden')
  setTimeout(() => el.style.display = 'none', 450)
}
function showBusy(on) {
  document.getElementById('db-busy').classList.toggle('show', on)
}

// ===== DB HELPERS =====
async function dbAll(query) {
  const res = await query
  if (res.error) { toast('DB error: ' + res.error.message); throw res.error }
  return res.data
}
async function dbOne(query) {
  const res = await query
  if (res.error) { toast('DB error: ' + res.error.message); throw res.error }
  return res.data
}

// ===== INIT =====
async function init() {
  try {
    setLoading('Loading products…', 20)
    await loadProducts()
    setLoading('Loading sales…', 55)
    await loadSales()
    setLoading('Loading adjustments…', 80)
    await loadAdjustments()
    setLoading('Ready!', 100)
    await new Promise(r => setTimeout(r, 300))
    buildCats(); renderProducts(); renderCart(); updateAlert()
    hideLoading()
  } catch(e) {
    setLoading('⚠ Could not connect. Check your Supabase credentials in the script.', 0)
    console.error(e)
  }
}

// ===== DATA LOADERS =====
async function loadProducts() {
  const data = await dbAll(sb.from('products').select('*').order('category').order('name'))
  products = data.map(p => ({ ...p, max: p.max_stock }))
}

async function loadSales() {
  const data = await dbAll(
    sb.from('sales').select('*, sale_items(*)').order('created_at', { ascending: false }).limit(200)
  )
  sales = data.map(s => ({
    db_id: s.id,
    num: String(s.id).padStart(4, '0'),
    ts: new Date(s.created_at),
    time: new Date(s.created_at).toLocaleTimeString('en-GB'),
    date: new Date(s.created_at).toLocaleDateString('en-GB'),
    method: s.method,
    items: (s.sale_items || []).map(i => ({ name: i.product_name, emoji: i.emoji, qty: i.qty, price: i.price, total: i.total })),
    sub: parseFloat(s.subtotal), damt: parseFloat(s.discount_amt),
    total: parseFloat(s.total), given: parseFloat(s.given),
    note: s.note, voided: s.voided
  }))
}

async function loadAdjustments() {
  const data = await dbAll(
    sb.from('stock_adjustments').select('*').order('created_at', { ascending: false }).limit(100)
  )
  adjustments = data.map(a => ({
    db_id: a.id,
    time: new Date(a.created_at).toLocaleTimeString('en-GB'),
    date: new Date(a.created_at).toLocaleDateString('en-GB'),
    productName: a.product_name, emoji: a.emoji,
    qty: a.qty_removed, reason: a.reason, note: a.note
  }))
}

// ===== CLOCK =====
function tick() { document.getElementById('clock').textContent = new Date().toLocaleTimeString('en-GB') }
setInterval(tick, 1000); tick()

// ===== TABS =====
function switchTab(tab, btn) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'))
  btn.classList.add('active')
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'))
  document.getElementById('view-' + tab).classList.add('active')
  if (tab === 'inventory') renderInventory()
  if (tab === 'sales') { renderSales(); renderSummaryPanel(activeSummaryTab) }
}

// ===== ALERT =====
function updateAlert() {
  if (alertDismissed) return
  const low = products.filter(p => p.stock > 0 && p.stock <= 5)
  const out = products.filter(p => p.stock === 0)
  const b = document.getElementById('alert-banner')
  if (!low.length && !out.length) { b.classList.add('hidden'); return }
  let parts = []
  if (out.length) parts.push(out.map(p => p.name).join(', ') + ' — out of stock')
  if (low.length) parts.push(low.map(p => p.name + ' (' + p.stock + ' left)').join(', ') + ' — low stock')
  document.getElementById('alert-text').textContent = 'Restock needed: ' + parts.join(' · ')
  b.classList.remove('hidden')
}
function dismissAlert() { alertDismissed = true; document.getElementById('alert-banner').classList.add('hidden') }

// ===== CATEGORIES =====
function buildCats() {
  const cats = ['All', ...new Set(products.map(p => p.category))]
  document.getElementById('cat-bar').innerHTML = cats.map(c =>
    `<button class="cat-btn ${c === activeCat ? 'active' : ''}" onclick="setCat('${c}')">${c}</button>`
  ).join('')
}
function setCat(c) { activeCat = c; buildCats(); renderProducts() }

// ===== PRODUCTS =====
function renderProducts() {
  const q = document.getElementById('pos-search').value.toLowerCase()
  const g = document.getElementById('product-grid')
  const f = products.filter(p =>
    (activeCat === 'All' || p.category === activeCat) &&
    (p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q))
  )
  if (!f.length) { g.innerHTML = '<div style="color:var(--t3);font-size:13px;padding:20px;grid-column:1/-1">No products found.</div>'; return }
  g.innerHTML = f.map(p => {
    const isOut = p.stock === 0, isLow = p.stock > 0 && p.stock <= 5
    return `<div class="product-card ${isOut ? 'oos' : ''}" onclick="${isOut ? '' : 'addToCart(' + p.id + ')'}">
      ${isOut ? '<div class="stock-badge badge-out">OUT</div>' : ''}
      ${isLow ? '<div class="stock-badge badge-low">LOW</div>' : ''}
      <div class="product-emoji">${p.emoji}</div>
      <div class="product-name">${p.name}</div>
      <div class="product-price">฿${p.price}</div>
      <div class="product-stock ${isLow ? 'low' : ''}">Stock: ${p.stock}</div>
    </div>`
  }).join('')
}

// ===== CART (all sync — local state) =====
function addToCart(id) {
  const p = products.find(x => x.id === id)
  if (!p || p.stock <= 0) return
  const ex = cart.find(i => i.id === id)
  if (ex) { if (ex.qty >= p.stock) { toast('Not enough stock!'); return }; ex.qty++ }
  else cart.push({ id, qty: 1 })
  renderCart(); renderProducts()
  toast(p.emoji + ' ' + p.name + ' added')
}
function changeQty(id, d) {
  const item = cart.find(i => i.id === id)
  const p = products.find(x => x.id === id)
  if (!item) return
  item.qty += d
  if (item.qty <= 0) cart = cart.filter(i => i.id !== id)
  else if (d > 0 && item.qty > p.stock) { item.qty--; toast('Not enough stock!') }
  renderCart(); renderProducts()
}
function clearCart() {
  cart = []; orderNote = ''
  document.getElementById('note-display').style.display = 'none'
  document.getElementById('note-btn').textContent = '+ Note'
  renderCart(); renderProducts()
}
function getCartTotals() {
  const sub = cart.reduce((s, i) => s + products.find(p => p.id === i.id).price * i.qty, 0)
  const dv = parseFloat(document.getElementById('disc-input').value) || 0
  const damt = discType === 'pct' ? sub * (Math.min(dv, 100) / 100) : Math.min(dv, sub)
  const total = sub - damt
  return { sub, damt, total }
}
function renderCart() {
  const el = document.getElementById('cart-items')
  const sw = document.getElementById('cart-summary-wrap')
  if (!cart.length) {
    el.innerHTML = '<div class="cart-empty"><div class="cart-empty-icon">🧾</div><span>Cart is empty</span></div>'
    sw.style.display = 'none'
    document.getElementById('charge-btn').disabled = true
    document.getElementById('charge-btn').textContent = 'Charge ฿0.00'
    document.getElementById('change-box').style.display = 'none'
    buildQuickCash(0); return
  }
  el.innerHTML = cart.map(item => {
    const p = products.find(x => x.id === item.id)
    return `<div class="cart-item">
      <div><div class="cart-item-name">${p.emoji} ${p.name}</div><div class="cart-item-price">฿${p.price} each</div></div>
      <div style="display:flex;align-items:center;gap:8px">
        <div class="qty-ctrl">
          <button class="qty-btn" onclick="changeQty(${item.id},-1)">−</button>
          <span class="qty-num">${item.qty}</span>
          <button class="qty-btn" onclick="changeQty(${item.id},1)">+</button>
        </div>
        <span class="line-total">฿${(p.price * item.qty).toFixed(0)}</span>
      </div>
    </div>`
  }).join('')
  const { sub, damt, total } = getCartTotals()
  const sl = document.getElementById('sub-line')
  const dl = document.getElementById('disc-line')
  if (damt > 0) {
    if (sl) sl.style.display = 'flex'
    dl.style.display = 'flex'
    document.getElementById('c-disc').textContent = '-฿' + damt.toFixed(2)
  } else {
    if (sl) sl.style.display = 'none'
    dl.style.display = 'none'
  }
  document.getElementById('c-sub').textContent = '฿' + sub.toFixed(2)
  document.getElementById('c-total').textContent = '฿' + total.toFixed(2)
  sw.style.display = 'block'
  const btn = document.getElementById('charge-btn')
  btn.disabled = false; btn.textContent = 'Charge ฿' + total.toFixed(2)
  buildQuickCash(total); updateChange()
}
function setDiscType(t) {
  discType = t
  document.getElementById('dt-pct').classList.toggle('active', t === 'pct')
  document.getElementById('dt-flat').classList.toggle('active', t === 'flat')
  renderCart()
}

// ===== CASH =====
function selectPay(btn, m) {
  payMethod = m
  document.querySelectorAll('.pay-btn').forEach(b => b.classList.remove('active'))
  btn.classList.add('active')
  document.getElementById('cash-section').style.display = m === 'Cash' ? 'block' : 'none'
  updateChange()
}
function buildQuickCash(total) {
  const row = document.getElementById('quick-cash')
  const opts = [50, 100, 200, 500, 1000].filter(v => v >= total).slice(0, 4)
  row.innerHTML = opts.map(v => `<button class="qc-btn" onclick="setQuickCash(${v})">฿${v}</button>`).join('')
}
function setQuickCash(v) { document.getElementById('cash-input').value = v; updateChange() }
function updateChange() {
  if (payMethod !== 'Cash') return
  const { total } = getCartTotals()
  const given = parseFloat(document.getElementById('cash-input').value) || 0
  const box = document.getElementById('change-box')
  if (!cart.length || !given) { box.style.display = 'none'; return }
  const change = given - total
  box.style.display = 'flex'
  box.className = 'change-box' + (change < 0 ? ' neg' : '')
  box.querySelector('.lbl').textContent = change < 0 ? 'Short by' : 'Change'
  document.getElementById('change-val').textContent = '฿' + Math.abs(change).toFixed(2)
}

// ===== NOTE =====
function openNoteModal() { document.getElementById('note-ta').value = orderNote; document.getElementById('note-modal').classList.add('open') }
function closeNoteModal() { document.getElementById('note-modal').classList.remove('open') }
function saveNote() {
  orderNote = document.getElementById('note-ta').value.trim()
  const d = document.getElementById('note-display'), nb = document.getElementById('note-btn')
  if (orderNote) { d.textContent = '📝 ' + orderNote; d.style.display = 'block'; nb.textContent = '✎ Note' }
  else { d.style.display = 'none'; nb.textContent = '+ Note' }
  closeNoteModal()
}

// ===== CHECKOUT (ASYNC) =====
async function checkout() {
  if (!cart.length) return
  const { sub, damt, total } = getCartTotals()
  const given = payMethod === 'Cash' ? (parseFloat(document.getElementById('cash-input').value) || 0) : total
  if (payMethod === 'Cash' && given < total) { toast('Cash given is less than total!'); return }
  showBusy(true)
  try {
    // 1. Insert sale
    const saleData = await dbOne(sb.from('sales').insert({
      method: payMethod, subtotal: sub, discount_amt: damt,
      total, given, note: orderNote || null
    }).select().single())

    // 2. Insert sale items
    await dbOne(sb.from('sale_items').insert(
      cart.map(item => {
        const p = products.find(x => x.id === item.id)
        return { sale_id: saleData.id, product_name: p.name, emoji: p.emoji, qty: item.qty, price: p.price, total: p.price * item.qty }
      })
    ))

    // 3. Deduct stock
    for (const item of cart) {
      const p = products.find(x => x.id === item.id)
      const newStock = Math.max(0, p.stock - item.qty)
      await dbOne(sb.from('products').update({ stock: newStock }).eq('id', p.id).select())
      p.stock = newStock
    }

    // 4. Build local sale record and show receipt
    const now = new Date()
    const sale = {
      db_id: saleData.id,
      num: String(saleData.id).padStart(4, '0'),
      ts: now, time: now.toLocaleTimeString('en-GB'), date: now.toLocaleDateString('en-GB'),
      method: payMethod,
      items: cart.map(item => {
        const p = products.find(x => x.id === item.id)
        return { name: p.name, emoji: p.emoji, qty: item.qty, price: p.price, total: p.price * item.qty }
      }),
      sub, damt, total, given, note: orderNote, voided: false
    }
    sales.unshift(sale)
    showReceipt(sale)
    cart = []; orderNote = ''
    document.getElementById('disc-input').value = ''
    document.getElementById('cash-input').value = ''
    document.getElementById('note-display').style.display = 'none'
    document.getElementById('note-btn').textContent = '+ Note'
    alertDismissed = false; updateAlert()
  } catch(e) { /* error already toasted by dbOne */ }
  showBusy(false)
}

// ===== RECEIPT =====
function showReceipt(sale) {
  document.getElementById('r-date').textContent = sale.date + ' ' + sale.time
  document.getElementById('r-total').textContent = '฿' + sale.total.toFixed(2)
  document.getElementById('r-method').textContent = sale.method
  document.getElementById('r-order-num').textContent = '#' + sale.num
  const dr = document.getElementById('r-disc-row'), sr = document.getElementById('r-sub-row')
  if (sale.damt > 0) {
    dr.style.display = 'flex'; document.getElementById('r-disc').textContent = '-฿' + sale.damt.toFixed(2)
    sr.style.display = 'flex'; document.getElementById('r-sub').textContent = '฿' + sale.sub.toFixed(2)
  } else { dr.style.display = 'none'; sr.style.display = 'none' }
  const tr = document.getElementById('r-tendered-row')
  if (sale.method === 'Cash') {
    tr.style.display = 'flex'; document.getElementById('r-tendered').textContent = '฿' + sale.given.toFixed(2)
    document.getElementById('r-change').textContent = '฿' + (sale.given - sale.total).toFixed(2)
  } else { tr.style.display = 'none'; document.getElementById('r-change').textContent = '—' }
  const nw = document.getElementById('r-note-wrap')
  if (sale.note) { nw.style.display = 'block'; document.getElementById('r-note').textContent = '📝 ' + sale.note } else nw.style.display = 'none'
  document.getElementById('r-items').innerHTML = sale.items.map(i =>
    `<div class="r-row"><span>${i.emoji} ${i.name} ×${i.qty}</span><span>฿${i.total.toFixed(2)}</span></div>`
  ).join('')
  document.getElementById('receipt-modal').classList.add('open')
}
function closeReceipt() { document.getElementById('receipt-modal').classList.remove('open'); renderCart(); renderProducts() }

// ===== INVENTORY — INLINE EDIT =====
function renderInventory() {
  const q = (document.getElementById('inv-search').value || '').toLowerCase()
  const low = products.filter(p => p.stock > 0 && p.stock <= 5).length
  const out = products.filter(p => p.stock === 0).length
  document.getElementById('i-total').textContent = products.length
  document.getElementById('i-low').textContent = low
  document.getElementById('i-out').textContent = out
  const filtered = products.filter(p => !q || p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q))
  document.getElementById('inv-tbody').innerHTML = filtered.map(p => {
    const pct = p.max > 0 ? Math.round(p.stock / p.max * 100) : 0
    const isLow = p.stock > 0 && p.stock <= 5, isOut = p.stock === 0
    const barColor = isOut ? 'var(--red)' : isLow ? 'var(--amber)' : 'var(--green)'
    const sc = isOut ? 's-out' : isLow ? 's-low' : 's-ok'
    const st = isOut ? 'Out of Stock' : isLow ? 'Low Stock' : 'In Stock'
    return `<tr id="row-${p.id}">
      <td><div class="cell-wrap" style="padding:10px 8px 10px 16px">
        <div class="item-icon" title="Change emoji" onclick="openEmojiModal(${p.id})">${p.emoji}</div>
      </div></td>
      <td><div class="cell-wrap">
        <input class="editable" value="${p.name.replace(/"/g,'&quot;')}" onchange="updateField(${p.id},'name',this.value)">
      </div></td>
      <td><div class="cell-wrap" style="padding:8px 16px">
        <select class="editable cat" onchange="updateField(${p.id},'category',this.value)">
          ${['Coffee','Tea','Food','Drinks','Other'].map(c => `<option ${c === p.category ? 'selected' : ''}>${c}</option>`).join('')}
        </select>
      </div></td>
      <td><div class="price-wrap">
        <span class="price-prefix">฿</span>
        <input class="price-edit" type="number" value="${p.price}" min="1" onchange="updateField(${p.id},'price',parseFloat(this.value)||${p.price})">
      </div></td>
      <td><div class="stock-cell">
        <div class="stock-editor">
          <div class="stock-bar-bg"><div class="stock-bar-fill" id="bar-${p.id}" style="width:${pct}%;background:${barColor}"></div></div>
          <input class="stock-input" id="si-${p.id}" type="number" value="${p.stock}" min="0"
            onchange="updateStock(${p.id},parseInt(this.value))"
            oninput="liveBarUpdate(${p.id},this.value)">
        </div>
      </div></td>
      <td><div class="cell-wrap"><span class="status-pill ${sc}" id="sp-${p.id}">${st}</span></div></td>
      <td><div class="cell-wrap" style="padding:8px">
        <button class="row-remove" onclick="openRemoveModal(${p.id})">− Remove</button>
        <button class="row-del" onclick="deleteProduct(${p.id})" title="Delete product entirely">✕</button>
      </div></td>
    </tr>`
  }).join('')
  renderAdjLog()
}

function liveBarUpdate(id, val) {
  const p = products.find(x => x.id === id); if (!p) return
  const v = parseInt(val) || 0
  const pct = p.max > 0 ? Math.min(Math.round(v / p.max * 100), 100) : 0
  const isLow = v > 0 && v <= 5, isOut = v === 0
  const barColor = isOut ? 'var(--red)' : isLow ? 'var(--amber)' : 'var(--green)'
  const bar = document.getElementById('bar-' + id), sp = document.getElementById('sp-' + id)
  if (bar) { bar.style.width = pct + '%'; bar.style.background = barColor }
  if (sp) { sp.className = 'status-pill ' + (isOut ? 's-out' : isLow ? 's-low' : 's-ok'); sp.textContent = isOut ? 'Out of Stock' : isLow ? 'Low Stock' : 'In Stock' }
}

async function updateStock(id, val) {
  const p = products.find(x => x.id === id); if (!p) return
  const newStock = Math.max(0, val || 0)
  p.stock = newStock; p.max = Math.max(p.max, newStock)
  liveBarUpdate(id, newStock)
  showBusy(true)
  try {
    await dbOne(sb.from('products').update({ stock: newStock, max_stock: p.max }).eq('id', id).select())
    renderProducts(); alertDismissed = false; updateAlert()
    toast('✓ Stock saved', true)
  } catch(e) {}
  showBusy(false)
}

async function updateField(id, field, val) {
  const p = products.find(x => x.id === id); if (!p) return
  const dbField = field === 'price' ? 'price' : field === 'name' ? 'name' : field
  const value = field === 'price' ? Math.max(1, parseFloat(val) || p.price) : val
  p[field] = value
  showBusy(true)
  try {
    await dbOne(sb.from('products').update({ [dbField]: value }).eq('id', id).select())
    renderProducts(); buildCats()
    toast('✓ Saved', true)
  } catch(e) {}
  showBusy(false)
}

async function deleteProduct(id) {
  const p = products.find(x => x.id === id)
  if (!confirm('Delete "' + p.name + '" from inventory?')) return
  showBusy(true)
  try {
    await dbOne(sb.from('products').delete().eq('id', id).select())
    products = products.filter(x => x.id !== id)
    cart = cart.filter(i => i.id !== id)
    renderInventory(); renderProducts(); buildCats()
    toast(p.name + ' removed')
