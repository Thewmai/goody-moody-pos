// ===== REMOVE STOCK =====
function openRemoveModal(id) {
  removeTargetId = id
  const p = products.find(x => x.id === id)
  document.getElementById('rm-emoji').textContent = p.emoji
  document.getElementById('rm-name').textContent = p.name
  document.getElementById('rm-stock-info').textContent = 'Current stock: ' + p.stock + ' units'
  document.getElementById('rm-qty').value = ''
  document.getElementById('rm-note').value = ''
  document.getElementById('rm-reason').value = 'damaged'
  document.getElementById('rm-preview').textContent = ''
  document.getElementById('remove-modal').classList.add('open')
}
function closeRemoveModal() { document.getElementById('remove-modal').classList.remove('open'); removeTargetId = null }
function updateRemovePreview() {
  if (removeTargetId === null) return
  const p = products.find(x => x.id === removeTargetId)
  const qty = parseInt(document.getElementById('rm-qty').value) || 0
  const prev = document.getElementById('rm-preview')
  if (!qty) { prev.textContent = ''; return }
  const after = p.stock - qty
  if (after < 0) { prev.textContent = 'Cannot remove more than ' + p.stock; prev.style.color = 'var(--red)' }
  else { prev.textContent = 'Stock after: ' + after + ' units'; prev.style.color = after <= 5 ? 'var(--amber)' : 'var(--t3)' }
}
async function confirmRemoveStock() {
  if (removeTargetId === null) return
  const p = products.find(x => x.id === removeTargetId)
  const qty = parseInt(document.getElementById('rm-qty').value) || 0
  const reason = document.getElementById('rm-reason').value
  const note = document.getElementById('rm-note').value.trim()
  if (!qty || qty <= 0) { toast('Enter a quantity to remove'); return }
  if (qty > p.stock) { toast('Cannot remove more than current stock (' + p.stock + ')'); return }
  const newStock = p.stock - qty
  showBusy(true)
  try {
    await dbOne(sb.from('products').update({ stock: newStock }).eq('id', p.id).select())
    await dbOne(sb.from('stock_adjustments').insert({
      product_id: p.id, product_name: p.name, emoji: p.emoji,
      qty_removed: qty, reason, note: note || null
    }).select())
    p.stock = newStock
    const now = new Date()
    adjustments.unshift({ time: now.toLocaleTimeString('en-GB'), date: now.toLocaleDateString('en-GB'), productName: p.name, emoji: p.emoji, qty, reason, note })
    closeRemoveModal(); renderInventory(); renderAdjLog(); renderProducts(); alertDismissed = false; updateAlert()
    toast('−' + qty + ' removed from ' + p.name)
  } catch(e) {}
  showBusy(false)
}
function renderAdjLog() {
  const section = document.getElementById('adj-section'), tbody = document.getElementById('adj-tbody')
  if (!adjustments.length) { section.style.display = 'none'; return }
  section.style.display = 'block'
  const labels = { damaged:'Damaged', expired:'Expired', stolen:'Stolen / Loss', shrinkage:'Shrinkage', adjustment:'Adjustment', other:'Other' }
  tbody.innerHTML = adjustments.map(a => `
    <tr>
      <td style="font-family:'DM Mono',monospace;font-size:12px;color:var(--t3)">${a.date} ${a.time}</td>
      <td><span style="margin-right:6px">${a.emoji}</span><strong style="color:var(--t1)">${a.productName}</strong></td>
      <td><span class="adj-qty">−${a.qty}</span></td>
      <td><span class="adj-pill r-${a.reason}">${labels[a.reason] || a.reason}</span></td>
      <td style="color:var(--t3);font-style:italic">${a.note || '—'}</td>
    </tr>`).join('')
}
async function clearAdjLog() {
  if (!confirm('Clear the removal log?')) return
  showBusy(true)
  try {
    // Delete all adjustments from DB for products we have
    const ids = adjustments.filter(a => a.db_id).map(a => a.db_id)
    if (ids.length) await dbOne(sb.from('stock_adjustments').delete().in('id', ids).select())
    adjustments = []
    renderAdjLog()
    toast('Log cleared')
  } catch(e) {}
  showBusy(false)
}

// ===== BULK RESTOCK =====
async function bulkRestock() {
  const needRestock = products.filter(p => p.stock < (p.max * 0.3) || p.stock === 0)
  if (!needRestock.length) { toast('All stock levels are healthy!', true); return }
  if (!confirm('Restock ' + needRestock.length + ' item(s) back to max?')) return
  showBusy(true)
  try {
    for (const p of needRestock) {
      await dbOne(sb.from('products').update({ stock: p.max }).eq('id', p.id).select())
      p.stock = p.max
    }
    renderInventory(); renderProducts(); alertDismissed = false; updateAlert()
    toast('✓ ' + needRestock.length + ' items restocked', true)
  } catch(e) {}
  showBusy(false)
}

// ===== SALES LIST =====
function renderSales() {
  const totalRev = sales.filter(s => !s.voided).reduce((s, t) => s + t.total, 0)
  const valid = sales.filter(s => !s.voided)
  document.getElementById('s-count').textContent = valid.length
  document.getElementById('s-rev').textContent = '฿' + totalRev.toFixed(2)
  document.getElementById('s-avg').textContent = '฿' + (valid.length ? (totalRev / valid.length).toFixed(2) : '0.00')
  const list = document.getElementById('sales-list')
  if (!sales.length) { list.innerHTML = '<div style="text-align:center;color:var(--t3);padding:60px 0;font-size:13px">No sales yet.</div>'; return }
  list.innerHTML = sales.map((sale, idx) => `
    <div class="sale-card ${sale.voided ? 'voided' : ''}">
      <div class="sale-head" onclick="toggleSale(${idx})">
        <span class="sale-num">Order #${sale.num}${sale.voided ? '<span class="void-badge">⊘ VOID</span>' : ''}</span>
        <span class="sale-time">${sale.date} ${sale.time}</span>
        <span class="sale-mpill">${sale.method}</span>
        <span class="sale-amt">฿${sale.total.toFixed(2)}</span>
        ${!sale.voided ? `<button onclick="event.stopPropagation();voidSale(${idx})" style="margin-left:8px;padding:3px 10px;border-radius:6px;border:1px solid var(--b);background:none;color:var(--t3);cursor:pointer;font-family:'Syne',sans-serif;font-size:11px;font-weight:600;transition:all .15s" onmouseover="this.style.borderColor='var(--red)';this.style.color='var(--red)'" onmouseout="this.style.borderColor='var(--b)';this.style.color='var(--t3)'">Void</button>` : ''}
      </div>
      <div class="sale-items" id="si-${idx}">
        ${sale.items.map(i => `<div class="sale-line"><span>${i.emoji} ${i.name} ×${i.qty}</span><span class="sale-line-val">฿${i.total.toFixed(2)}</span></div>`).join('')}
        ${sale.damt > 0 ? `<div class="sale-line"><span style="color:var(--green)">Discount</span><span class="sale-line-val" style="color:var(--green)">-฿${sale.damt.toFixed(2)}</span></div>` : ''}
        <div class="sale-line"><span style="color:var(--t1);font-weight:600">Total</span><span class="sale-line-val" style="color:var(--amber)">฿${sale.total.toFixed(2)}</span></div>
        ${sale.note ? `<div style="padding:4px 0;font-size:12px;color:var(--blue);font-style:italic">📝 ${sale.note}</div>` : ''}
        ${sale.voided ? `<div style="padding:4px 0;font-size:12px;color:var(--red)">⊘ Voided — stock restored.</div>` : ''}
      </div>
    </div>`).join('')
}
function toggleSale(idx) { document.getElementById('si-' + idx).classList.toggle('open') }

// ===== VOID SALE =====
async function voidSale(idx) {
  const sale = sales[idx]
  if (sale.voided) { toast('Already voided'); return }
  if (!confirm('Void Order #' + sale.num + '? Stock will be restored.')) return
  showBusy(true)
  try {
    await dbOne(sb.from('sales').update({ voided: true }).eq('id', sale.db_id).select())
    for (const item of sale.items) {
      const p = products.find(x => x.name === item.name)
      if (p) {
        const newStock = p.stock + item.qty
        await dbOne(sb.from('products').update({ stock: newStock }).eq('id', p.id).select())
        p.stock = newStock
      }
    }
    sale.voided = true
    renderSales(); renderSummaryPanel(activeSummaryTab); renderProducts(); alertDismissed = false; updateAlert()
    toast('Order #' + sale.num + ' voided — stock restored')
  } catch(e) {}
  showBusy(false)
}

// ===== SUMMARY TABS =====
function switchSummaryTab(tab, btn) {
  activeSummaryTab = tab
  document.querySelectorAll('.summary-tab').forEach(b => b.classList.remove('active'))
  btn.classList.add('active')
  document.querySelectorAll('.summary-panel').forEach(p => p.classList.remove('active'))
  document.getElementById('panel-' + tab).classList.add('active')
  renderSummaryPanel(tab)
}
function filterSales(period) {
  const now = new Date()
  return sales.filter(s => {
    if (s.voided) return false
    const d = s.ts || new Date()
    if (period === 'today') return d.toDateString() === now.toDateString()
    if (period === 'week') {
      const sow = new Date(now); sow.setDate(now.getDate() - now.getDay()); sow.setHours(0,0,0,0)
      return d >= sow
    }
    return true
  })
}
function buildKPICards(filtered) {
  const rev = filtered.reduce((s, t) => s + t.total, 0)
  const avg = filtered.length ? rev / filtered.length : 0
  const totalItems = filtered.reduce((s, t) => s + t.items.reduce((a, i) => a + i.qty, 0), 0)
  return `<div class="sum-kpi-grid">
    <div class="kpi"><div class="kpi-val">${filtered.length}</div><div class="kpi-lbl">Orders</div></div>
    <div class="kpi"><div class="kpi-val">${totalItems}</div><div class="kpi-lbl">Items Sold</div></div>
    <div class="kpi full"><div class="kpi-val">฿${rev.toFixed(2)}</div><div class="kpi-lbl">Revenue</div></div>
    <div class="kpi"><div class="kpi-val">฿${avg.toFixed(2)}</div><div class="kpi-lbl">Avg Order</div></div>
    <div class="kpi"><div class="kpi-val">${filtered.filter(s => s.damt > 0).length}</div><div class="kpi-lbl">Discounted</div></div>
  </div>`
}
function buildTopProducts(filtered) {
  const tally = {}
  filtered.forEach(s => s.items.forEach(i => {
    if (!tally[i.name]) tally[i.name] = { qty: 0, emoji: i.emoji }
    tally[i.name].qty += i.qty
  }))
  const sorted = Object.entries(tally).sort((a, b) => b[1].qty - a[1].qty).slice(0, 6)
  if (!sorted.length) return '<div style="color:var(--t3);font-size:12px;padding:8px 0">No data.</div>'
  const mx = sorted[0][1].qty
  return sorted.map(([name, d], i) => `
    <div class="top-item-row">
      <span class="ti-rank">${i+1}</span><span>${d.emoji}</span>
      <span class="ti-name">${name}</span>
      <div class="ti-bar-bg"><div class="ti-bar" style="width:${Math.round(d.qty/mx*100)}%"></div></div>
      <span class="ti-qty">${d.qty}</span>
    </div>`).join('')
}
function buildPayBreakdown(filtered) {
  const m = {}
  filtered.forEach(s => { if (!m[s.method]) m[s.method] = { count: 0, rev: 0 }; m[s.method].count++; m[s.method].rev += s.total })
  const icons = { Cash: '💵', Card: '💳', QR: '📱' }
  if (!Object.keys(m).length) return '<div style="color:var(--t3);font-size:12px;padding:8px 0">No data.</div>'
  return Object.entries(m).sort((a, b) => b[1].rev - a[1].rev).map(([k, v]) => `
    <div class="method-row">
      <span class="method-name">${icons[k]||'💰'} ${k}</span>
      <div class="method-stats"><span class="method-cnt">${v.count}×</span><span class="method-rev">฿${v.rev.toFixed(2)}</span></div>
    </div>`).join('')
}
function buildHourChart(filtered) {
  const hrs = Array(24).fill(0)
  filtered.forEach(s => hrs[(s.ts || new Date()).getHours()] += s.total)
  const mx = Math.max(...hrs, 1)
  return '<div class="hour-bar-row">' + hrs.map((v, h) => `
    <div class="h-bar-wrap" title="${h}:00 — ฿${v.toFixed(0)}">
      <div class="h-bar" style="height:${v ? Math.max(4,Math.round(v/mx*40))+'px' : '2px'};opacity:${v ? 1 : .2}"></div>
      ${h % 4 === 0 ? `<span class="h-lbl">${h}</span>` : ''}
    </div>`).join('') + '</div>'
}
function buildWeekSparkline() {
  const now = new Date()
  const days = Array.from({length:7}, (_, i) => { const d = new Date(now); d.setDate(now.getDate() - (6-i)); d.setHours(0,0,0,0); return { date: d, label: ['Su','Mo','Tu','We','Th','Fr','Sa'][d.getDay()], rev: 0 } })
  filterSales('week').forEach(s => { const sd = new Date(s.ts); sd.setHours(0,0,0,0); const day = days.find(d => d.date.getTime() === sd.getTime()); if (day) day.rev += s.total })
  const mx = Math.max(...days.map(d => d.rev), 1)
  return '<div class="sparkline-wrap">' + days.map(d => `
    <div class="spark-col" title="${d.label}: ฿${d.rev.toFixed(0)}">
      <div class="spark-val">${d.rev > 0 ? '฿'+Math.round(d.rev) : ''}</div>
      <div class="spark-bar" style="height:${d.rev ? Math.max(6,Math.round(d.rev/mx*36))+'px' : '4px'};background:${d.rev ? 'var(--amber)' : 'var(--hov)'}"></div>
      <div class="spark-day">${d.label}</div>
    </div>`).join('') + '</div>'
}
function renderSummaryPanel(tab) {
  if (tab === 'today' || tab === 'week') {
    const filtered = filterSales(tab)
    document.getElementById('panel-' + tab).innerHTML = `
      <div class="sum-card"><div class="sum-card-title">${tab === 'today' ? 'Today' : 'This Week'} — Overview</div>${buildKPICards(filtered)}</div>
      <div class="sum-card"><div class="sum-card-title">Top Products</div>${buildTopProducts(filtered)}</div>
      <div class="sum-card"><div class="sum-card-title">Payment Methods</div>${buildPayBreakdown(filtered)}</div>
      ${tab === 'today'
        ? `<div class="sum-card"><div class="sum-card-title">Sales by Hour</div>${buildHourChart(filtered)}</div>`
        : `<div class="sum-card"><div class="sum-card-title">7-Day Revenue</div>${buildWeekSparkline()}</div>`}`
  }
  if (tab === 'analytics') {
    const all = sales.filter(s => !s.voided)
    document.getElementById('panel-analytics').innerHTML = `
      <div class="sum-card"><div class="sum-card-title">All Time Overview</div>${buildKPICards(all)}</div>
      <div class="sum-card"><div class="sum-card-title">Best Sellers</div>${buildTopProducts(all)}</div>
      <div class="sum-card"><div class="sum-card-title">Payment Breakdown</div>${buildPayBreakdown(all)}</div>`
  }
}

// ===== EXPORT EXCEL =====
function exportCSV() {
  if (!sales.length) { toast('No sales to export'); return }
  const wb = XLSX.utils.book_new()
  const salesRows = [['Order','Date','Time','Payment','Items','Subtotal (฿)','Discount (฿)','Total (฿)','Voided','Note']]
  sales.forEach(s => salesRows.push([
    '#'+s.num, s.date, s.time, s.method,
    s.items.map(i => i.qty+'x '+i.name).join(' | '),
    +s.sub.toFixed(2), +s.damt.toFixed(2), +s.total.toFixed(2),
    s.voided ? 'YES' : 'NO', s.note || ''
  ]))
  const ws1 = XLSX.utils.aoa_to_sheet(salesRows)
  ws1['!cols'] = [{wch:8},{wch:12},{wch:10},{wch:10},{wch:40},{wch:14},{wch:14},{wch:12},{wch:8},{wch:28}]
  XLSX.utils.book_append_sheet(wb, ws1, 'Sales')
  const all = sales.filter(s => !s.voided)
  const rev = all.reduce((s,t) => s+t.total, 0)
  const tally = {}; all.forEach(s => s.items.forEach(i => { if(!tally[i.name]) tally[i.name]={qty:0,rev:0}; tally[i.name].qty+=i.qty; tally[i.name].rev+=i.total }))
  const top = Object.entries(tally).sort((a,b)=>b[1].qty-a[1].qty).slice(0,10)
  const m = {}; all.forEach(s => { if(!m[s.method]) m[s.method]={count:0,rev:0}; m[s.method].count++; m[s.method].rev+=s.total })
  const sumRows = [
    ['goodi moodi — Summary'],['Generated', new Date().toLocaleString('en-GB')],[],
    ['OVERVIEW','All Time','Today','This Week'],
    ['Orders', all.length, filterSales('today').length, filterSales('week').length],
    ['Revenue (฿)', +rev.toFixed(2), +filterSales('today').reduce((s,t)=>s+t.total,0).toFixed(2), +filterSales('week').reduce((s,t)=>s+t.total,0).toFixed(2)],
    ['Voided', sales.filter(s=>s.voided).length, '', ''],
    [],['TOP PRODUCTS','Units Sold','Revenue (฿)'],
    ...top.map(([name,d]) => [name, d.qty, +d.rev.toFixed(2)]),
    [],['PAYMENT METHODS','Orders','Revenue (฿)'],
    ...Object.entries(m).map(([k,v]) => [k, v.count, +v.rev.toFixed(2)])
  ]
  const ws2 = XLSX.utils.aoa_to_sheet(sumRows)
  ws2['!cols'] = [{wch:28},{wch:16},{wch:16},{wch:16}]
  XLSX.utils.book_append_sheet(wb, ws2, 'Summary')
  XLSX.writeFile(wb, 'goodi-moodi-' + new Date().toISOString().slice(0,10) + '.xlsx')
  toast('✓ Excel exported', true)
}

